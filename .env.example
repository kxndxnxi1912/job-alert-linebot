# ==========================================
# LINE BOT CREDENTIALS
# รับค่าจาก LINE Developers Console (Messaging API Channel)
# ==========================================
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# (ไม่บังคับ) User ID ของคุณ ถ้าต้องการให้ระบบแอดลงฐานข้อมูลอัตโนมัติตั้งแต่เริ่ม
DEFAULT_LINE_USER_ID=

# ==========================================
# DATABASE SETTINGS
# บน Railway: เชื่อมต่อ Postgres Railway จะมี DATABASE_URL ให้อัตโนมัติ
# บน Local: ถ้าเว้นว่างไว้ ระบบจะใช้ SQLite (sqlite:///jobs.db) โดยอัตโนมัติ
# ==========================================
DATABASE_URL=

# ==========================================
# SCRAPER & MONITOR SETTINGS
# ==========================================
# ความถี่ในการสแกนงาน (วินาที) เช่น 180 = ทุก 3 นาที
POLL_INTERVAL_SECONDS=180

# เปิด/ปิดการตรวจจับจากแหล่งต่างๆ
FASTWORK_ENABLED=true
FACEBOOK_ENABLED=true

# ==========================================
# FACEBOOK GROUPS SETTINGS
# ==========================================
# รายชื่อ Facebook Group ID หรือ URL ที่ต้องการมอนิเตอร์ (คั่นด้วยเครื่องหมายจุลภาค)
FB_GROUP_IDS=

# (ไม่บังคับ) Cookie ของ Facebook ถ้าต้องการดึงโพสต์จากกลุ่มผ่าน mbasic
FB_COOKIE=

# (ไม่บังคับ) ลิงก์ RSS ของกลุ่ม Facebook (เช่น จาก RSS-Bridge หรือ FetchRSS)
FB_RSS_URLS=

# เปิดการแจ้งเตือนตัวอย่างโพสต์เฟสบุ๊คเมื่อยังไม่ได้ใส่ Cookie/RSS เพื่อทดสอบระบบ
FB_DEMO_FALLBACK=true

# ==========================================
# SERVER PORT
# ==========================================
PORT=5000
